{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assist.consultation/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestID", "transportSessionID", "turnID", "expectedRevision", "locale", "input", "contextSnapshot", "consentReceiptRef"],
  "properties": {
    "schemaVersion": {"const": "assist.consultation/1.0"},
    "requestID": {"$ref": "#/$defs/reference"},
    "transportSessionID": {"$ref": "#/$defs/reference"},
    "turnID": {"$ref": "#/$defs/reference"},
    "expectedRevision": {"type": "integer"},
    "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
    "input": {"$ref": "#/$defs/input"},
    "contextSnapshot": {"$ref": "#/$defs/contextSnapshot"},
    "consentReceiptRef": {"$ref": "#/$defs/reference"}
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["value"],
      "properties": {"value": {"type": "string", "pattern": "^[a-z][a-z0-9]*-[A-Za-z0-9_-]{1,96}$"}}
    },
    "date": {"type": "string", "minLength": 20},
    "consent": {
      "type": "object", "additionalProperties": false, "required": ["ref", "state", "scope", "recordedAt"],
      "properties": {
        "ref": {"$ref": "#/$defs/reference"},
        "state": {"enum": ["granted", "refused", "revoked"]},
        "scope": {"enum": ["none", "question", "context", "question_and_context"]},
        "recordedAt": {"$ref": "#/$defs/date"}
      }
    },
    "evidenceValue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "text"}, "text": {"type": "string", "maxLength": 2000}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "number"], "properties": {"kind": {"const": "number"}, "number": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "boolean"], "properties": {"kind": {"const": "boolean"}, "boolean": {"type": "boolean"}}}
      ]
    },
    "evidenceFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subjectRef", "property", "value", "sourceType", "sourceRefs", "observedAt", "consentScope", "qualityStatus", "derivedFrom"],
      "properties": {
        "id": {"$ref": "#/$defs/reference"}, "subjectRef": {"$ref": "#/$defs/reference"},
        "property": {"type": "string", "minLength": 1, "maxLength": 120}, "value": {"$ref": "#/$defs/evidenceValue"},
        "unit": {"type": ["string", "null"], "maxLength": 32},
        "sourceType": {"enum": ["user_declared", "system_observed", "manufacturer_documented", "curated_knowledge", "derived"]},
        "sourceRefs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/reference"}},
        "observedAt": {"$ref": "#/$defs/date"}, "validUntil": {"type": ["string", "null"]},
        "consentScope": {"enum": ["none", "question", "context", "question_and_context"]},
        "qualityStatus": {"enum": ["usable", "partial", "stale", "conflicted", "unavailable"]},
        "derivedFrom": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "retrievedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/reference"},
        "kind": {"enum": ["user_declaration", "system_measurement", "official_document", "curated_reference"]},
        "url": {"type": ["string", "null"], "maxLength": 2048},
        "retrievedAt": {"$ref": "#/$defs/date"}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "evidenceRefs", "limitations"],
      "properties": {
        "id": {"$ref": "#/$defs/reference"}, "text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/reference"}},
        "limitations": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}}
      }
    },
    "absence": {
      "type": "object", "additionalProperties": false, "required": ["id", "subjectRef", "property", "reason", "observedAt", "sourceRefs"],
      "properties": {
        "id": {"$ref": "#/$defs/reference"}, "subjectRef": {"$ref": "#/$defs/reference"},
        "property": {"type": "string", "minLength": 1, "maxLength": 120},
        "reason": {"enum": ["not_collected", "expired", "conflicted", "deleted", "unavailable", "ineligible_measurement", "consent_not_granted"]},
        "observedAt": {"$ref": "#/$defs/date"},
        "sourceRefs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false, "required": ["id", "profileRef", "measuredAt", "validUntil", "method", "values"],
      "properties": {
        "id": {"$ref": "#/$defs/reference"}, "profileRef": {"$ref": "#/$defs/reference"},
        "measuredAt": {"$ref": "#/$defs/date"}, "validUntil": {"$ref": "#/$defs/date"},
        "method": {"const": "app_measurement"},
        "values": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/evidenceFact"}}
      }
    },
    "contextSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "snapshotID", "revision", "intent", "consent", "createdAt", "sources", "facts", "hypotheses", "absences", "measurements"],
      "properties": {
        "schemaVersion": {"const": "assist.consultation/1.0"}, "snapshotID": {"$ref": "#/$defs/reference"},
        "revision": {"type": "integer"},
        "intent": {"enum": ["open_question", "slow_connection", "router_adequacy", "mesh_need", "plan_value"]},
        "consent": {"$ref": "#/$defs/consent"}, "createdAt": {"$ref": "#/$defs/date"},
        "sources": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/source"}},
        "facts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidenceFact"}},
        "hypotheses": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/hypothesis"}},
        "absences": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/absence"}},
        "measurements": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/measurement"}}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["kind", "text"],
      "properties": {"kind": {"const": "user_message"}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}}
    }
  }
}
