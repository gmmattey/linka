{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assist.consultation/1.0/response",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requestID", "transportSessionID", "turnID", "revision", "outcome"],
  "properties": {"schemaVersion": {"const": "assist.consultation/1.0"}, "requestID": {"$ref": "#/$defs/reference"}, "transportSessionID": {"$ref": "#/$defs/reference"}, "turnID": {"$ref": "#/$defs/reference"}, "revision": {"type": "integer"}, "outcome": {"$ref": "#/$defs/outcome"}},
  "$defs": {
    "reference": {"type": "object", "additionalProperties": false, "required": ["value"], "properties": {"value": {"type": "string", "pattern": "^[a-z][a-z0-9]*-[A-Za-z0-9_-]{1,96}$"}}},
    "date": {"type": "string", "minLength": 20},
    "argumentValue": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "text"}, "text": {"type": "string", "maxLength": 2000}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "number"], "properties": {"kind": {"const": "number"}, "number": {"type": "number"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "boolean"], "properties": {"kind": {"const": "boolean"}, "boolean": {"type": "boolean"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "reference"], "properties": {"kind": {"const": "reference"}, "reference": {"$ref": "#/$defs/reference"}}}]},
    "argument": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "value": {"$ref": "#/$defs/argumentValue"}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "evidenceRefs", "appliesToRefs"], "properties": {"id": {"$ref": "#/$defs/reference"}, "kind": {"enum": ["observation", "declaration", "capability", "general_knowledge", "hypothesis"]}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidenceRefs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}, "appliesToRefs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}}},
    "gap": {"type": "object", "additionalProperties": false, "required": ["id", "text", "evidenceRefs"], "properties": {"id": {"$ref": "#/$defs/reference"}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidenceRefs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}}},
    "assessment": {"type": "object", "additionalProperties": false, "required": ["conclusion", "summary", "observations", "hypotheses", "unknowns", "evidenceRefs", "actionIDs", "alternatives", "limitations"], "properties": {"conclusion": {"enum": ["next_test", "safe_action", "escalation", "insufficient", "keep", "adjust", "upgrade_candidate", "not_justified", "reposition_candidate", "wired_ap_candidate", "mesh_candidate", "usage_fit", "review_cost", "capacity_candidate", "commercial_data_missing", "explained", "needs_context"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "observations": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 2000}}, "hypotheses": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 2000}}, "unknowns": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/gap"}}, "evidenceRefs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}, "actionIDs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}, "alternatives": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 2000}}, "limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 2000}}}},
    "questionOption": {"type": "object", "additionalProperties": false, "required": ["id", "text", "kind"], "properties": {"id": {"$ref": "#/$defs/reference"}, "text": {"type": "string", "minLength": 1, "maxLength": 1000}, "kind": {"enum": ["option", "unknown"]}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "text", "options", "allowFreeText", "allowUnknown", "rationale", "nextState"], "properties": {"id": {"$ref": "#/$defs/reference"}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}, "options": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/questionOption"}}, "allowFreeText": {"type": "boolean"}, "allowUnknown": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}, "nextState": {"const": "awaiting_answer"}}},
    "toolProposal": {"type": "object", "additionalProperties": false, "required": ["id", "tool", "arguments", "objective", "evidenceRefs", "risk", "expiresAt", "revision"], "properties": {"id": {"$ref": "#/$defs/reference"}, "tool": {"enum": ["read_network_context", "select_measurement_evidence", "evaluate_opportunities", "lookup_device_specs", "retrieve_network_guidance", "propose_network_test", "run_existing_test", "compare_measurements", "save_consultation"]}, "arguments": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/argument"}}, "objective": {"type": "string", "minLength": 1, "maxLength": 2000}, "evidenceRefs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}, "risk": {"enum": ["none", "low", "medium", "high"]}, "expiresAt": {"$ref": "#/$defs/date"}, "revision": {"type": "integer"}}},
    "actionProposal": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "title", "steps", "evidenceRefs", "limitations"], "properties": {"id": {"$ref": "#/$defs/reference"}, "kind": {"enum": ["inspect", "adjust", "contact_support", "retest"]}, "title": {"type": "string", "minLength": 1, "maxLength": 2000}, "steps": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}, "evidenceRefs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reference"}}, "limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 2000}}, "expiresAt": {"type": ["string", "null"]}}},
    "next": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "question"], "properties": {"kind": {"const": "question"}, "question": {"$ref": "#/$defs/question"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "tool_proposal"], "properties": {"kind": {"const": "tool_proposal"}, "tool_proposal": {"$ref": "#/$defs/toolProposal"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "action_proposal"], "properties": {"kind": {"const": "action_proposal"}, "action_proposal": {"$ref": "#/$defs/actionProposal"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}}
    ]},
    "turn": {"type": "object", "additionalProperties": false, "required": ["intent", "disposition", "claims", "limitations", "next"], "properties": {"intent": {"enum": ["open_question", "slow_connection", "router_adequacy", "mesh_need", "plan_value"]}, "disposition": {"enum": ["awaiting_answer", "awaiting_approval", "answered", "inconclusive", "out_of_scope", "unavailable"]}, "claims": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/claim"}}, "limitations": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 2000}}, "assessment": {"anyOf": [{"$ref": "#/$defs/assessment"}, {"type": "null"}]}, "next": {"$ref": "#/$defs/next"}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "recoverable", "fallback"], "properties": {"code": {"enum": ["invalid_request", "revision_conflict", "consent_required", "unavailable", "out_of_scope", "policy_blocked", "expired_proposal"]}, "message": {"type": "string", "minLength": 1, "maxLength": 2000}, "recoverable": {"type": "boolean"}, "fallback": {"enum": ["retry", "refresh_context", "ask_question", "stop"]}, "currentRevision": {"type": ["integer", "null"]}}},
    "outcome": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "turn"], "properties": {"kind": {"const": "turn"}, "turn": {"$ref": "#/$defs/turn"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "error"], "properties": {"kind": {"const": "error"}, "error": {"$ref": "#/$defs/error"}}}
    ]}
  }
}
