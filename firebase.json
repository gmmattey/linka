{
  "hosting": {
    "public": "aplicacao-web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/casawifi/privacidade",
        "destination": "/casawifi/privacidade/index.html"
      },
      {
        "source": "/casawifi/privacidade/**",
        "destination": "/casawifi/privacidade/index.html"
      },
      {
        "source": "/casawifi",
        "destination": "/casawifi/privacidade/index.html"
      },
      {
        "source": "/casawifi/**",
        "destination": "/casawifi/privacidade/index.html"
      },
      {
        "source": "/lagcheck/suporte",
        "destination": "/lagcheck/suporte/index.html"
      },
      {
        "source": "/lagcheck/suporte/**",
        "destination": "/lagcheck/suporte/index.html"
      },
      {
        "source": "/lagcheck/privacidade",
        "destination": "/lagcheck/privacidade/index.html"
      },
      {
        "source": "/lagcheck/privacidade/**",
        "destination": "/lagcheck/privacidade/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
